# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks

# Global properties
separator=true
separator_block_width=40

# [keyboard]
# command=swaymsg -t get_inputs | jq -r '.[] | select(.identifier == "39658:4137:K68_BT5.0_Keyboard" and .type == "keyboard").xkb_active_layout_name'
# interval=10

[battery-notifier]
command=bat-notify
interval=60

[power-profile]
command=if [ $button ]; then change-power-profiler; else powerprofilesctl get; fi
interval=3

[volume]
command=pactl get-sink-volume @DEFAULT_SINK@ | grep Volume | awk '{print $5}'
interval=1

# [wireless]
# command=iwgetid -r
# interval=5
[cpu]
command=df -h | grep /dev/nvme0n1p2 | awk '{ print $4 }'
interval=200

[memmory]
command=free -h | awk '/^Mem/ { print $3 }'
interval=1

[network]
command=if [ $button ]; then kitty --title "iwctl" iwctl; else iwgetid -r; fi
interval=5

[battery]
command=/home/bern/.local/bin/bn-bat
interval=60

[clock]
command=if [ $button ]; then gsimplecal; else date '+%d/%m/%Y %H:%M '; fi
interval=1
